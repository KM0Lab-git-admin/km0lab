# Copia este fichero a `app/keystore.properties` (gitignored) y rellena los
# valores del keystore de release que generes con `keytool`.
# El keystore NO se commitea: guárdalo fuera del repo (p. ej.
# `C:\\Users\\Propietario\\.keystores\\km0lab-release.jks`) y haz copia de
# seguridad. Si lo pierdes no podrás actualizar la app en Google Play.
#
# Comando para generar el keystore:
#   keytool -genkey -v -keystore km0lab-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias km0lab
#
# `storeFile` puede ser una ruta absoluta o relativa al módulo `app/`.
storeFile=C:\\Users\\Propietario\\.keystores\\km0lab-release.jks
storePassword=CHANGE_ME
keyAlias=km0lab
keyPassword=CHANGE_ME
